<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="10dp"
    app:cardBackgroundColor="?attr/colorSurfaceVariant"
    app:cardCornerRadius="20dp"
    style="@style/Widget.App.CardStyle">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="3dp"
        android:orientation="vertical">
        <com.google.android.material.textview.MaterialTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:paddingLeft="2dp"
            android:paddingBottom="10dp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:textSize="15dp"
            android:maxLines="1"
            android:text="LABEL"
            />
        <View
            android:layout_width="match_parent"
            android:layout_height=".5dp"
            android:background="?attr/colorOutline"/>
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/fileName"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:padding="5dp"
            android:text=""
            android:hint="Enter Text"
            android:textColor="?attr/colorOnBackground"
            android:textColorHint="?attr/colorOnSurface"
            android:textSize="11dp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="5dp"
                android:textStyle="bold"
                android:textSize="11dp"
                android:maxLines="1"
                android:textColor="?attr/colorOnBackground"
                android:text="FontSize"
                />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/fontDropDown"
                    android:layout_width="110dp"
                    android:layout_height="50dp"
                    android:padding="5dp"
                    android:text=""
                    android:inputType="number"
                    android:textColor="?attr/colorOnBackground"
                    android:textColorHint="?attr/colorOnSurface"
                    android:textSize="11dp" />
                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/showPopup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorOnBackground"
                    android:tint="?attr/backgroundColor"
                    android:src="@drawable/dropdown"/>
            </LinearLayout>

        </LinearLayout>

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="5dp"
            android:textStyle="bold"
            android:textSize="12dp"
            android:maxLines="1"
            android:textColor="?attr/colorOnBackground"
            android:text="Alignment"
            />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <RadioGroup
                android:id="@+id/alignmentLeftRight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal">
                <RadioButton
                    android:id="@+id/align_left"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp"
                    android:padding="5dp"
                    android:background="@drawable/radio_button_custom"
                    android:button="@null"
                    android:layout_weight="1"
                    android:text="Left"
                    android:textSize="10dp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnBackground"
                    android:gravity="center"
                    android:checked="true"/>
                <RadioButton
                    android:id="@+id/align_right"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp"
                    android:padding="5dp"
                    android:background="@drawable/radio_button_custom"
                    android:button="@null"
                    android:layout_weight="1"
                    android:text="Right"
                    android:textSize="10dp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnBackground"
                    android:gravity="center"
                    android:checked="false"/>
                <RadioButton
                    android:id="@+id/align_lr_center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp"
                    android:padding="5dp"
                    android:background="@drawable/radio_button_custom"
                    android:button="@null"
                    android:layout_weight="1"
                    android:text="Center"
                    android:textSize="10dp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnBackground"
                    android:gravity="center"
                    android:checked="false"/>
            </RadioGroup>
            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_margin="5dp"
                android:background="?attr/colorOutline"/>
            <RadioGroup
                android:id="@+id/alignmentTopBottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal">
                <RadioButton
                    android:id="@+id/align_top"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp"
                    android:padding="5dp"
                    android:background="@drawable/radio_button_custom"
                    android:button="@null"
                    android:layout_weight="1"
                    android:text="Top"
                    android:textSize="10dp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnBackground"
                    android:gravity="center"
                    android:checked="true"/>
                <RadioButton
                    android:id="@+id/align_bottom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp"
                    android:padding="5dp"
                    android:background="@drawable/radio_button_custom"
                    android:button="@null"
                    android:layout_weight="1"
                    android:text="Bottom"
                    android:textSize="10dp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnBackground"
                    android:gravity="center"
                    android:checked="false"/>
                <RadioButton
                    android:id="@+id/align_tb_center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp"
                    android:padding="5dp"
                    android:background="@drawable/radio_button_custom"
                    android:button="@null"
                    android:layout_weight="1"
                    android:text="Center"
                    android:textSize="10dp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnBackground"
                    android:gravity="center"
                    android:checked="false"/>
            </RadioGroup>
        </LinearLayout>
        </HorizontalScrollView>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="10dp"
            android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/save"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:text="Accept"
                style="@style/customButtonStyle"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:text="Cancel"
                style="@style/customButtonStyle"/>
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
