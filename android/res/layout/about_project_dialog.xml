<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="10dp"
    app:cardBackgroundColor="?attr/colorSurfaceVariant"
    app:cardCornerRadius="20dp"
    style="@style/Widget.App.CardStyle">
    <LinearLayout
        android:layout_margin="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:paddingTop="10dp"
                android:paddingLeft="2dp"
                android:paddingBottom="10dp"
                android:textStyle="bold"
                android:textSize="20dp"
                android:textColor="?attr/colorOnSurface"
                android:text="About"
                />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/close"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                app:tint="?attr/colorOnSurface"
                app:srcCompat="@drawable/close"/>
        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:background="@color/gray"/>


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal">
            <com.google.android.material.card.MaterialCardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:padding="2dp"
                app:cardBackgroundColor="?attr/colorSurfaceVariant"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                style="@style/Widget.App.CardStyle">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:padding="5dp"
                    android:background="?attr/colorOnPrimary"
                    android:tint="?attr/colorPrimary"
                    app:srcCompat="@drawable/ic_launcher_foreground" />
            </com.google.android.material.card.MaterialCardView>
            <LinearLayout
                android:padding="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:orientation="vertical">
                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:textSize="12dp"
                    android:text="SimuLogic"
                    android:textColor="?attr/colorOnSurface"
                    />
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/versionName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="normal"
                    android:textSize="11dp"
                    android:text="Version 1.3"
                    android:textColor="?attr/colorOnSurface"
                    />
            </LinearLayout>
        </LinearLayout>
        <com.google.android.material.textview.MaterialTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="15dp"
            android:textColor="?attr/colorOnSurface"
            android:textFontWeight="400"
            android:breakStrategy="high_quality"
            android:text="Why make this project?"
            />
        <com.google.android.material.textview.MaterialTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13dp"
            android:textColor="?attr/colorOnSurface"
            android:textFontWeight="300"
            android:breakStrategy="high_quality"
            android:text="Digital logic is the first step if you want to understand how hardware works at a conceptual level, digital logic will provide you with a solid foundation especially if you desire to start learning FPGA(Field Programmable Gate Array) or maybe CPU design. This app provides a more approachable way to learn especially for people with no electrical engineering background."
            />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/review"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_margin="5dp"
            android:text="Review App"
            style="@style/customButtonStyle"/>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
